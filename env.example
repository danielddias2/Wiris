# ============================================================
# WIRIS VIANA — Variáveis de Ambiente do Servidor de Métricas
# NUNCA commite o arquivo .env real com valores preenchidos.
# Copie este arquivo para .env e preencha os valores reais.
# ============================================================

PORT=3001

# ── CORS ────────────────────────────────────────────────────
# Domínio do frontend em produção
# Em dev local: http://localhost:8080 ou file://
CORS_ORIGIN=*

# ── MODO DE MÉTRICAS ─────────────────────────────────────────
# "manual" → usa valores configurados em socialMetricsService.js
# "live"   → busca das APIs reais (requer credenciais abaixo)
METRICS_MODE=manual

# ── CACHE ────────────────────────────────────────────────────
# TTL do cache em segundos (padrão: 300 = 5 minutos)
CACHE_TTL_SECONDS=300

# ── YOUTUBE DATA API v3 ──────────────────────────────────────
# Obtenha em: https://console.cloud.google.com/
# 1. Crie projeto → Ative YouTube Data API v3 → Credenciais → Chave de API
YOUTUBE_API_KEY=
# ID do canal: youtube.com/channel/UC[ID_AQUI]
YOUTUBE_CHANNEL_ID=

# ── TIKTOK FOR DEVELOPERS ────────────────────────────────────
# Obtenha em: https://developers.tiktok.com/
# Requer app aprovado com acesso à Display API ou Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Access token obtido via fluxo OAuth do creator
TIKTOK_ACCESS_TOKEN=
# Open ID do usuário autenticado
TIKTOK_OPEN_ID=

# ── META GRAPH API (Instagram Business) ──────────────────────
# Obtenha em: https://developers.facebook.com/
# A conta Instagram deve ser Business ou Creator
# Requer permissões: instagram_basic, pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── KWAI OPEN PLATFORM ───────────────────────────────────────
# Obtenha em: https://open.kwai.com/
# Requer app aprovado e fluxo OAuth do creator
KWAI_ACCESS_TOKEN=
KWAI_OPEN_ID=
